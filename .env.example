# Copy to .env for local runs. Never commit .env.
# (Real posting runs on GitHub Actions — media must be served from GitHub
#  Pages, so locally you'll normally only use --dry-run.)
IG_ACCESS_TOKEN=your-long-lived-instagram-token
IG_USER_ID=17841419875074899
# Optional: where the joke model (llama.cpp llama-server) is listening.
# The workflow starts it automatically; locally, --dry-run falls back to a
# placeholder joke if nothing is running here.
# LLM_URL=http://127.0.0.1:8080/v1/chat/completions
# Optional: full path to blender.exe if it isn't on PATH
# BLENDER_PATH=C:\Users\you\AppData\Local\Programs\blender-4.5.12-windows-x64\blender.exe
